# ---------------- Python ----------------
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
build/
dist/
.eggs/

# ---------------- 虚拟环境 ----------------
.venv/
venv/
env/

# ---------------- 环境变量 / 密钥 ----------------
.env
.env.*
!.env.example

# ---------------- 测试与工具缓存 ----------------
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# 前端 e2e（Playwright）的产物与报告
web/test-results/
web/playwright-report/
web/blob-report/

# ---------------- 前端 ----------------
node_modules/
dist/
.vite/

# 例外：前端构建产物**要进版本库**。
# release 让用户 clone 下来就能直接跑（`make api` 会一并托管它，见 server/main.py），
# 不必先装 Node 再构建。两条都得写：先放行目录本身，再放行目录里的文件
!web/dist/
!web/dist/**

# ---------------- 本地运行时数据 ----------------
data/

# 改动快照（「还原」用的前像），落在数据根下。和 data/ 同性质：跟着这台机器上的会话
# 长出来，内容是用户工作目录里那些文件的历史版本，不该进版本库。
# 它不在 data/ 里面 —— 就地运行时数据根就是仓库根，所以得单独一行
checkpoints/

# 桌面壳的日志（同样落在数据根下：双击启动时没有终端，输出只能往文件里写）
desktop.log

# 打包产物（发布用，不进仓库；web/dist 是例外，见上面「前端」那段）
release/

# 上传附件的落脚处（默认落在工作目录内，可能含敏感内容）
.attachments/

# ---------------- 设计源文件 ----------------
# 图标与配色的设计稿（含 .icns / .miora 等源文件和导出脚本）。
# 实际用到的素材已经复制到 web/src/assets 和 web/public 下，构建不依赖这里
quill-source/

# ---------------- 操作系统 ----------------
.DS_Store

# playwright-cli（手工排查时的命令行浏览器）留下的快照
.playwright-cli/

# 设计稿工作目录（开发期素材，构建不依赖；实际素材已复制进 web/src/assets）
Quill Glass Blue/
